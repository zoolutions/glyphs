{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",
      "mcp__github__*",
      "Bash(bundle exec:*)",
      "Bash(git *)",
      "Bash(ruby *)",
      "Bash(gh *)",
      "Bash(ls:*)",
      "Bash(bin/rails *)",
      "Bash(rake *)"
    ]
  },
  "model": "opus",
  "advisorModel": "fable",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "extraKnownMarketplaces": {
    "zoolutions": {
      "source": {
        "source": "github",
        "repo": "zoolutions/claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "flow@zoolutions": true,
    "ruby-gem@zoolutions": true
  }
}
